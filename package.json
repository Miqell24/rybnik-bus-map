{
  "name": "rybnik-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Rybnik region public transport (KM Rybnik, BKM Żory, MZK Jastrzębie, Wodzisław county) — GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=4096 pipeline/build.mjs --all",
    "schematic": "node --max-old-space-size=4096 pipeline/schematic/build-schematic.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "serve": "node pipeline/serve.mjs 8134",
    "lines": "node pipeline/lines.mjs",
    "audit": "node --max-old-space-size=6144 pipeline/audit.mjs"
  }
}
